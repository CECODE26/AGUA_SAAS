# Copia este archivo a mobile/.env y completa los valores.
# Para los builds de EAS, cárgalos también como variables del proyecto en expo.dev.

# Servidor de la plataforma (sin barra al final)
EXPO_PUBLIC_API_URL=https://tu-servidor.com
# Slug de la distribuidora dueña de esta app (el mismo del panel de plataforma)
EXPO_PUBLIC_DISTRIBUIDORA=
# Nombre que ve el usuario dentro de la app
EXPO_PUBLIC_NOMBRE_MARCA=
# Token público de Mapbox (rutas del chofer)
EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# ── Datos del build (app.config.js) ──
# Identificador en las tiendas (ej. com.aguanorte.app) y, si difiere, el de iOS
APP_ID=
APP_ID_IOS=
APP_SLUG=
APP_SCHEME=
# Clave de Google Maps restringida a APP_ID
GOOGLE_MAPS_API_KEY=
# Proyecto y dueño en expo.dev
EAS_PROJECT_ID=
EXPO_OWNER=
