{
  "expo": {
    "name": "Agua Elite",
    "slug": "agua-elite",
    "scheme": "aguaelite",
    "version": "1.4.8",
    "orientation": "portrait",
    "icon": "./src/assets/logoooo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0066CC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aguaelite.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "La app necesita tu ubicación para asignarte entregas cercanas.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "La app necesita tu ubicación para asignarte entregas cercanas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logoooo.png",
        "backgroundColor": "#0C1F3F"
      },
      "package": "com.aguaelite.app",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./src/assets/logoooo.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app necesita tu ubicación para asignarte entregas cercanas."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#0066CC"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7451355d-4641-437e-9d8b-4ce10a75102b"
      }
    },
    "owner": "janick1"
  }
}
