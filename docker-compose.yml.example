# ⚠️  ESTE ES UN ARCHIVO TEMPLATE — NO CONTIENE SECRETOS REALES
# Copiar a docker-compose.yml y llenar con valores reales de .env

services:

  # ── Base de datos PostgreSQL ──────────────────────────────
  db:
    image: postgres:15-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB:       agua_piatua
      POSTGRES_USER:     postgres
      POSTGRES_PASSWORD: ${DB_PASSWORD}
    volumes:
      - pgdata:/var/lib/postgresql/data
    ports:
      - "5433:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 10

  # ── Servidor Express + Prisma ─────────────────────────────
  server:
    build: ./server
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    env_file: ./server/.env
    environment:
      DATABASE_URL: postgresql://postgres:${DB_PASSWORD}@db:5432/agua_piatua
    volumes:
      - uploads:/app/uploads
    ports:
      - "3001:3001"

  # ── Cliente React (nginx) ─────────────────────────────────
  client:
    build:
      context: ./client
      args:
        VITE_MAPBOX_TOKEN: ${VITE_MAPBOX_TOKEN}
    restart: unless-stopped
    depends_on:
      - server
    ports:
      - "8080:80"

volumes:
  pgdata:
  uploads:
