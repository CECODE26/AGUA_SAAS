# DATABASE
DATABASE_URL=postgresql://postgres:PASSWORD@db:5432/agua_elite
DB_PASSWORD=PASSWORD_SEGURO_AQUI

# JWT (generar con: openssl rand -base64 32)
JWT_SECRET=GENERA_CON_OPENSSL_RAND_BASE64_32

# PLATAFORMA (SaaS)
# Dominio raíz: cada distribuidora sin dominio propio responde en <slug>.PLATAFORMA_DOMINIO
PLATAFORMA_DOMINIO=aguaelite.com
# Primer admin de la plataforma (lo crea el seed si no existe; mínimo 10 caracteres)
PLATAFORMA_USUARIO=
PLATAFORMA_PASSWORD=
# Instalación de una sola empresa: slug que se usa cuando la petición no dice cuál
DISTRIBUIDORA_POR_DEFECTO=
# Orígenes web extra permitidos por CORS, separados por coma
CORS_ORIGINS=
# SEED_DEMO=1 crea la distribuidora "demo" si la base está vacía (solo desarrollo)
SEED_DEMO=
SEED_DEMO_PASSWORD=

# EMAIL (Gmail app password). Los avisos de pedidos van al "correo de avisos" de cada
# distribuidora; MAIL_ADMIN solo se usa si la distribuidora no cargó uno.
MAIL_USER=tu_email@gmail.com
MAIL_PASS=GMAIL_APP_PASSWORD
MAIL_ADMIN=

# MAPBOX (obtener en https://account.mapbox.com/tokens/)
MAPBOX_TOKEN=
VITE_MAPBOX_TOKEN=pk.eyJ...

# URL del sitio cuando no hay PLATAFORMA_DOMINIO ni dominio propio (links en correos)
SITE_URL=http://localhost:5173
