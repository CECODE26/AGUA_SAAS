# Copia a client/.env.local para desarrollo.

# Solo en desarrollo local y en la app de Capacitor: slug de la distribuidora que se
# muestra (va en el encabezado X-Distribuidora). En producción web NO se define:
# la distribuidora sale del dominio (aguanorte.com o <slug>.aguaelite.com).
VITE_DISTRIBUIDORA=
# App de Capacitor: servidor de la plataforma (en web se usa /api relativo)
VITE_API_URL=
# Token público de Mapbox
VITE_MAPBOX_TOKEN=pk.eyJ...
# Enlace a la app de la distribuidora en Google Play (si no hay, el botón no lleva a ningún lado)
VITE_PLAY_STORE_URL=

# Landing de Agua Elite (dominio de la plataforma): contacto para ventas. Si faltan los
# dos, la sección de contacto solo ofrece la demo.
VITE_CONTACTO_WHATSAPP=
VITE_CONTACTO_EMAIL=
